#include <iostream>
#include <cstdlib>
#include <ctime>
using namespace std;

int main ()
{
    srand(time(nullptr)); // gives seed for rng
    
    int randomnumber;
    
    randomnumber = rand() % 10 + 1; // creates random number 0-9 and adds 1 so it becomes 1-10
    
    int guessingnumber;
    
    cout << "Welcome to my advanced number guessing game 1-10, I am thinking of a number, guess it!" << endl;
    
    cout << "Enter what number you think I am thinking of: " ;
    
    cin >> guessingnumber;
    
    if (guessingnumber < 1)
    {
        cout << "That number is below 1, try again" ;
    }
    
    else if (guessingnumber > 10)
    {
        cout << "That number is bigger than 10, try again" ;
    }
    
    else if (guessingnumber == randomnumber)
    {
        cout << "Ok fine you win" ;
    }
    
    else
    {
        cout << "I win" ;
    }
    return 0;
}
